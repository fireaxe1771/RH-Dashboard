server {
    listen 80;
    server_name localhost;

    # Proxy API requests to the FastAPI backend. BACKEND_URL is substituted at
    # container startup (see Dockerfile / NGINX_ENVSUBST_FILTER). Without this
    # block, /api/* falls through to the SPA fallback below and returns
    # index.html, which breaks JSON parsing on the client.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        # Send the backend's own FQDN as Host so the shared Azure Container Apps
        # ingress routes the request to the backend app. Sending the frontend
        # host ($host) causes the ACA ingress to reset the TLS connection
        # because no container app matches that host on the backend's IP.
        # The original frontend host is preserved via X-Forwarded-Host.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The ACA ingress (Envoy) requires SNI to route HTTPS upstreams.
        # Without proxy_ssl_server_name, nginx omits SNI and Envoy resets the
        # connection during the TLS handshake (502 Bad Gateway).
        proxy_ssl_server_name on;
        proxy_ssl_verify off;

        # SQL queries against Azure temporal tables can take 10-30s each;
        # with 12 widgets loading in parallel the backend needs headroom.
        proxy_read_timeout 180s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
    }

    # Hashed assets (Vite content-hashed JS/CSS) — safe to cache aggressively.
    # The filename changes when content changes, so a stale cache entry is never
    # served. immutable tells the browser to skip even conditional revalidation.
    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html must NEVER be cached — it references the hashed asset files by
    # name, so a stale index.html points at asset filenames that no longer exist
    # on the server after a rebuild. no-store forces the browser to fetch a
    # fresh copy on every navigation, ensuring it always references the current
    # hashed assets.
    location = /index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
